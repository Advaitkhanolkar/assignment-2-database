    {
      "name": "4. Add Student with Valid JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Student created successfully and ID saved\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.be.a(\"number\");",
              "    pm.expect(jsonData.name).to.eql(\"Aarav Sharma\");",
              "    pm.expect(jsonData.email).to.eql(\"aarav.sharma@college.edu\");",
              "    pm.expect(jsonData.branch).to.eql(\"Computer Science\");",
              "    pm.expect(jsonData.year).to.eql(3);",
              "    // Automatically save created student ID into collection variable",
              "    pm.collectionVariables.set(\"studentId\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
